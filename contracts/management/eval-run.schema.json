{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "set_id": {
      "type": "string",
      "minLength": 1
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "keyword",
          "semantic",
          "ask",
          "ask_graph",
          "ask_rerank"
        ]
      }
    },
    "k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "set_id"
  ],
  "additionalProperties": false
}
