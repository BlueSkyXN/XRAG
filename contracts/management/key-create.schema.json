{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XRAG Demo.3 key-create",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "role"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role": {
      "enum": [
        "reader",
        "contributor",
        "maintainer",
        "admin"
      ]
    },
    "kbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "description": "Runtime requires existing nonempty KB scope for non-admin; expiry is future timestamp or zero; length max in runtime is UTF-8 bytes."
}
