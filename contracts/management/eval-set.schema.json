{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kb": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expected": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "expected_empty": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "minItems": 1
              },
              "expected_empty": {
                "const": false
              }
            }
          },
          {
            "required": [
              "expected_empty"
            ],
            "properties": {
              "expected_empty": {
                "const": true
              },
              "expected": {
                "maxItems": 0
              }
            }
          }
        ]
      }
    },
    "family": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "development",
        "holdout"
      ]
    }
  },
  "required": [
    "kb",
    "name",
    "cases"
  ],
  "additionalProperties": false
}
