{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XRAG Demo response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.7-demo"
    },
    "query_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "server",
        "local",
        "direct"
      ]
    },
    "kbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "accuracy": {
          "enum": [
            "exact",
            "unknown",
            "lower_bound",
            "estimate"
          ]
        },
        "unit": {
          "type": "string"
        },
        "calculation_complete": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "accuracy",
        "unit",
        "calculation_complete",
        "scope"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "execution_partial",
        "display_truncated",
        "approximate",
        "consistency",
        "scope_basis"
      ]
    },
    "strategy": {
      "type": "object"
    },
    "notes": {
      "type": "array"
    },
    "cache_complete": {
      "type": "boolean"
    },
    "summary_ref": {
      "type": "string"
    },
    "failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {},
        "hint": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "status": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "action",
    "mode",
    "kbs",
    "items",
    "returned",
    "total",
    "coverage",
    "strategy",
    "notes",
    "cache_complete"
  ]
}
