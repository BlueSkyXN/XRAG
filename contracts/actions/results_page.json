{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "results.page",
  "type": "object",
  "properties": {
    "kbs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 50
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    }
  },
  "required": [
    "result_id"
  ],
  "additionalProperties": false
}
