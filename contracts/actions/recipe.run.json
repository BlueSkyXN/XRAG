{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kb",
    "goal",
    "recipe"
  ],
  "properties": {
    "kb": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "path": {
      "type": "string"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "steps"
      ],
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "xrag.recipe/v1"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "arguments"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "kb.discover",
                  "search.keyword",
                  "search.semantic",
                  "files.read",
                  "files.grep",
                  "graph.entity",
                  "graph.neighbors",
                  "graph.path",
                  "graph.chunks",
                  "+context",
                  "+ask"
                ]
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
